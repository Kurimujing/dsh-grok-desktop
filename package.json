{
  "name": "dsh-grok-desktop",
  "version": "0.1.0",
  "description": "Desktop-safe Grok route for DeepSeek Harness. No web client bundle, so enabling it cannot crash the desktop shell.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "cordis.patch.yml", "README.md"],
  "license": "MIT",
  "keywords": ["dsh-plugin", "deepseek-harness", "grok", "xai"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
